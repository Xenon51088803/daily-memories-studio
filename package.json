{
  "name": "daily-memories-studio",
  "version": "0.2.0",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3310",
    "build": "next build --webpack",
    "biome-write": "npx @biomejs/biome format --write .",
    "start": "next start --hostname 127.0.0.1 --port 3310",
    "typecheck": "next typegen && tsc --noEmit",
    "export:web": "node scripts/export-site.mjs",
    "publish:web": "node scripts/publish-pages.mjs",
    "check:publish": "node scripts/publish-pages.mjs --check",
    "studio": "node scripts/start-studio.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup:github": "node scripts/configure-publish.mjs",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/setup-content.mjs",
    "setup:content": "node scripts/setup-content.mjs",
    "check:source": "node scripts/check-source.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@next/mdx": "^16.0.10",
    "@once-ui-system/core": "1.5.6",
    "classnames": "^2.5.1",
    "cookie": "^1.0.2",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lint-staged": "^16.1.5",
    "next": "^16.0.10",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sass": "^1.86.3",
    "sharp": "0.33.5",
    "transliteration": "^2.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.64.0",
    "@types/cookie": "^0.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20.17.30",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.25.0",
    "typescript": "^5.8.3",
    "tzdata": "^1.0.44"
  },
